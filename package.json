{
  "name": "steam-market-monitor-bot",
  "version": "0.1.0",
  "description": "Base architecture for a Steam Community Market monitoring and purchasing bot",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run build",
    "worker:watcher": "tsx src/workers/watcher.ts",
    "worker:prices": "tsx src/workers/price-updater.ts",
    "vanilla:watch": "node sniper.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "axios-retry": "^4.5.0",
    "bottleneck": "^2.19.5",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.6.0",
    "playwright": "^1.50.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.24.2",
    "pg": "^8.13.3",
    "https-proxy-agent": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "pino-pretty": "^13.0.0"
  }
}