NODE_ENV=development

STEAM_APP_ID=730
MARKET_HASH_NAME=AK-47 | Asiimov (Field-Tested)
STEAM_COUNTRY=PT
STEAM_LANGUAGE=portuguese
STEAM_CURRENCY=3
STEAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36

REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgres://user:password@localhost:5432/steam_bot

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

STEAM_SESSION_ID=your_sessionid_cookie
STEAM_LOGIN_SECURE=your_steamLoginSecure_cookie
STEAM_WALLET_CURRENCY=3

TARGET_MARGIN_PERCENT=5
STEAM_NET_MULTIPLIER=0.87
PRICE_REFRESH_MINUTES=15
MAX_BUY_PRICE=25

WATCHER_INTERVAL_MIN_MS=500
WATCHER_INTERVAL_MAX_MS=1000
REQUEST_TIMEOUT_MS=6000
REQUEST_JITTER_MIN_MS=50
REQUEST_JITTER_MAX_MS=200

# CSV de proxies, ex:
# http://user:pass@proxy1:10000,http://user:pass@proxy2:10000
PROXY_LIST=

# Zero-dependencies (vanilla Node.js monitor)
VANILLA_POLL_INTERVAL_MS=5000
VANILLA_MAX_ALERT_PRICE_EUR=10

# Vanilla price updater
PRICE_SOURCE_URL=https://api.prices.example/cs2
PRICE_OUTPUT_FILE=prices.json

# Vanilla profitability rule (Steam price must be <= reference * multiplier)
PROFITABILITY_MULTIPLIER=0.80
